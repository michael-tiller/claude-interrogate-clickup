{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_claude-interrogate-clickup_clickup__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/clickup-ledger-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/clickup-lifecycle-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
